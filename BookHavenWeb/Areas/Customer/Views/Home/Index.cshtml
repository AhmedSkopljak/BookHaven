@model IEnumerable<Product>
<div class="row pb-3">
    @foreach (var product in Model)
    {
        <div class="col-lg-3 col-sm-6">
            <div class="col-12 p-1">
                <a asp-action="Details" asp-route-productId="@product.Id" class="text-decoration-none card-link-hover">
                    <div class="card border-0 p-3 shadow border-top border-5 rounded">
                        <img src="@product.ImageUrl" alt="image" class="card-img-top rounded">
                        <div class="card-boy pb-0 pt-2">
                            <div class="pl-1">
                                <p class="card-title h5 text-dark opacity-75 text-uppercase text-center">@product.Title</p>
                                <p class="card-title text-warning text-center">by <b>@product.Author</b></p>
                            </div>
                            <div class="pl-1">
                                <p class="text-dark text-opacity-75 text-center mb-0"><span>List price: </span>@product.ListPrice.ToString("C")</p>
                            </div>
                            <div class="pl-1">
                                <p class="text-dark text-opacity-75 text-center">As low as: <span>@product.Price100.ToString("C")</span></p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    }
</div>