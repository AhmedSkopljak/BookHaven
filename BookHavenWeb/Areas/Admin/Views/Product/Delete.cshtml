@model Product

<form method="post">
    <div class="border mt-4 p-3 mb-5">
        <div class="row pb-4 ">
            <h2 class="text-primary">Delete Product</h2>
        </div>
        <div class="mb-3 row">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" disabled="disabled">
        </div>
        <div class="mb-3 row">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" disabled="disabled"></textarea>
        </div>
        <div class="mb-3 row">
            <label asp-for="ISBN"></label>
            <input asp-for="ISBN" class="form-control" disabled="disabled">
        </div>
        <div class="mb-3 row">
            <label asp-for="Author"></label>
            <input asp-for="Author" class="form-control" disabled="disabled">
        </div>
        <div class="mb-3 row">
            <label asp-for="ListPrice"></label>
            <input asp-for="ListPrice" class="form-control" disabled="disabled">
        </div>
        <div class="mb-3 row">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" disabled="disabled">
        </div>
        <div class="mb-3 row">
            <label asp-for="Price50"></label>
            <input asp-for="Price50" class="form-control" disabled="disabled"> 
        </div>
        <div class="mb-3 row">
            <label asp-for="Price100"></label>
            <input asp-for="Price100" class="form-control" disabled="disabled">
        </div>
        <div class="row">
            <div class="col-6 col-md-3">
                <button class="btn btn-primary form-control">Delete</button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary form-control">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</form>